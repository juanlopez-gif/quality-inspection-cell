<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quality_cell</name>
  <version>1.0.0</version>
  <description>Quality inspection cell (conveyor + IR sensor + camera + uFactory robot) with a rule-based supervisor, full simulation and web dashboard.</description>
  <maintainer email="juan.lopez@uri.edu">Capstone TA</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>cell_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- Real UR7e driver also needs the ur_rtde Python library (pip: ur_rtde), see docs/13 -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
